main();

#include <drivers\drv_gl.txt>

float x = 256;
float y = 256;
float rad = 12;
float xTog = 0;
float yTog = 0;
float xrate = 4;
float yrate = 3;
float xrateTog = 1;
float yrateTog = 1;
float leftPoints = 0;
float rightPoints = 0;
float PadSize = 52;
float PadSpeed = 5;
float lPad = 230;
float lPbot;
float lPmid;
float rPad = 230;
float rPbot;
float rPmid;

void main()
{
    //=========================================
    // AI control.
    //=========================================
    // Left
    if(x < 256)
    {
        if(lPmid < y)
        {
            lPad = lPad + PadSpeed;
        }
        else if(lPmid > y)
        {
            lPad = lPad - PadSpeed;
        }
    }
    else{
        if(lPmid < 250)
        {
            lPad = lPad + PadSpeed;
        }
        else if(lPmid > 272)
        {
            lPad = lPad - PadSpeed;
        }
    }
    // Right
    if(x > 256)
    {
        if(rPmid < y)
        {
            rPad = rPad + PadSpeed;
        }
        else if(rPmid > y)
        {
            rPad = rPad - PadSpeed;
        }
    }
    else{
        if(rPmid < 250)
        {
            rPad = rPad + PadSpeed;
        }
        else if(rPmid > 272)
        {
            rPad = rPad - PadSpeed;
        }
    }
    //=========================================
    // Paddle Control.
    //=========================================
    if(lPad < 128)
    {
        lPad = 128
    }
    else if(lPad > (384 - PadSize))
    {
        lPad = (384 - PadSize);
    }
    
    if(rPad < 128)
    {
        rPad = 128
    }
    else if(rPad > (384 - PadSize))
    {
        rPad = (384 - PadSize);
    }
    lPbot = lPad + 52;
    rPbot = rPad + 52;
    lPmid = lPad + 26;
    rPmid = rPad + 26;
    //=========================================
    // Ball bounce math.
    //=========================================
    if(xTog)
    {
        x = x + xrate;
    }
    else if(!xTog)
    {
        x = x - xrate;
    }
    
    if(yTog)
    {
        y = y + yrate;
    }
    else if(!yTog)
    {
        y = y - yrate;
    }
    //=========================================
    // Ball bounce control.
    //=========================================
    
    if(x <= 38)
    {
        if(y > lPad)
        {
            if(y < lPbot)
            {
                xTog = 1;
                if(yrateTog)
                {
                    yrate = yrate + 0.1;
                }
                else if(!yrateTog)
                {
                    yrate = yrate - 0.1;
                }
            }
        }
    }
    if(x < 10)//Left
    {
        x = 256;
        y = 256;
        xTog = 1;
        rightPoints++;
    }
    
    if(x >= 468)
    {
        if(y > rPad)
        {
            if(y < rPbot)
            {
                xTog = 0;
                if(yrateTog)
                {
                    yrate = yrate + 0.1;
                }
                else if(!yrateTog)
                {
                    yrate = yrate - 0.1;
                }
            }
        }
    }
    if(x > 502)//Right
    {
        x = 256;
        y = 256;
        xTog = 0;
        leftPoints++;
    }
    
    if(y > (374 - (rad / 2)))//Bottom
    {
        yTog = 0;
        if(xrateTog)
        {
            xrate = xrate + 0.1;
        }
        else if(!xrateTog)
        {
            xrate = xrate - 0.1;
        }
    }
    
    if(y < (138 + (rad / 2)))//Top
    {
        yTog = 1;
        if(xrateTog)
        {
            xrate = xrate + 0.1;
        }
        else if(!xrateTog)
        {
            xrate = xrate - 0.1;
        }
    }    
    //=========================================
    // Ball speed control.
    //=========================================
    if(xrate < 4)
    {
        xrateTog = 1;
    }
    else if(xrate > 7)
    {
        xrateTog = 0;
    }
    
    if(yrate < 3)
    {
        yrateTog = 1;
    }
    else if(yrate > 6)
    {
        yrateTog = 0;
    }
    //=========================================
    // Drawing.
    //=========================================
    glColor(42,42,42);
    glRect(0,0,512,128);
    glRect(0,384,512,512);
    
    glColor4(84,42,42,120);
    glRect(0,128,10,384);
    
    glColor4(42,42,84,120);
    glRect(502,128,512,384);
    
    glColor(84,84,84);
    glLine(0,128,512,128);
    glLine(0,384,512,384);
    glLine(256,0,256,384);
    
    glColor(255,255,255);
    glCircleQuality(24);
    glCircle(x,y,rad);
    
    glRectWH(20,lPad,12,52);
    glRectWH(480,rPad,12,52);
    
    glFontSize(40);
    glFontAlign(1);
    glColor(255,126,126);
    glWriteFloat((200,80,leftPoints);
    glColor(126,126,255);
    glWriteFloat(312,80,rightPoints);
    glExit();
    //=========================================
}
