@name Naki's Stargates V8.0 - Handheld DHD
@inputs TextEntry:string Dial
@persist Address:string TargetEnt:entity Open
@outputs Address:string TargetEnt:entity Open
if(dupefinished()){reset()}
if(first()){
    dsJoinGroup("stargate-naki")
    dsSetScope(2)
    runOnSignal("stargate-naki",2,1)
    #include "glyph_repository"
}
interval(100)

event chat(Player:entity, Message:string, Team:number) {
    if(Player==owner()){
        local LS = Message:explode(" ")
        hideChat(Message:sub(1,1)=="/")
        if(LS[1,string]=="/dial"){
            local Address = LS[2,string]
            findExcludeEntity(entity())
            findIncludeClass(entity():type())
            findIncludeModel("models/sprops/geometry/fdisc_132.mdl")
            findInSphere(owner():pos(),600)
            findSortByDistance(owner():pos())
            TargetEnt=findResult(1)
            if(TargetEnt){
                hint("Stargate located! Dialing...",7)
                dsSend(TargetEnt:id()+"_getaddress","stargate-naki",table(owner(),Address))
            }else{
                hint("No stargates found nearby!",7)
            }
            TargetEnt=noentity()
        }
    }
}
